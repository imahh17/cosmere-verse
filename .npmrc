# Peer dependencies are installed automatically; peer issues warn, not block.
auto-install-peers=true
strict-peer-dependencies=false

# Hoist types, eslint and prettier so editors and tools can resolve them.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=prettier

# No phantom dependencies.
shamefully-hoist=false

# Always use a lockfile. In CI, use --frozen-lockfile to block updates.
lockfile=true
prefer-frozen-lockfile=true
