---
import './SiteFooter.scss';

interface Props {
  brand: string;
  disclaimer: string;
}

const { brand, disclaimer } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner wrapper">
    <p class="site-footer__brand">{brand}</p>
    <p class="site-footer__disclaimer">{disclaimer}</p>
  </div>
</footer>
